<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lab.MainMenuController">
   <center>
      <Group BorderPane.alignment="CENTER">
         <children>
            <Canvas fx:id="canvas" height="700.0" layoutX="14.0" width="500.0" />
            <VBox alignment="CENTER" fillWidth="false" layoutX="73.0" layoutY="367.0" spacing="40.0">
               <children>
                  <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #303030;">
                     <children>
                        <Label style="-fx-background-color: #303030;" text="Player name:" textFill="WHITE">
                           <font>
                              <Font name="Arial Bold" size="18.0" />
                           </font>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </Label>
                        <TextField fx:id="PlayerName" promptText="Enter player name" style="-fx-background-color: #303030; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-family: 'Arial';">
                           <HBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </HBox.margin>
                        </TextField>
                     </children>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <padding>
                        <Insets bottom="5.0" left="10.0" right="5.0" top="5.0" />
                     </padding>
                  </HBox>
                  <Button fx:id="startGameButton" mnemonicParsing="false" onAction="#StartGamePressed" style="-fx-background-color: #303030; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-family: 'Arial'; -fx-padding: 10 20;" text="Start Game" />
                  <Button fx:id="highScoresButton" mnemonicParsing="false" onAction="#HighScoresPressed" style="-fx-background-color: #303030; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-family: 'Arial'; -fx-padding: 10 20;" text="High Scores" />
                  <Button fx:id="exitGameButton" mnemonicParsing="false" onAction="#ExitGamePressed" style="-fx-background-color: #303030; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-family: 'Arial'; -fx-padding: 10 20;" text="Exit Game" />
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </Group>
   </center>
</BorderPane>
